<script>
	$(document).ready(function() {
		$('#account-summary-box .progress-bar').each(function () {
			var percentage = 0;
			var value = $(this).attr('data-value');
			var max   = $(this).attr('data-max');

			if (max != "unlimited") {
				percentage = (value * 100) / max;
			}

			if (percentage > 100) {
				percentage = 100;
			}
			
			var progress_level = "progress-level" + Math.floor(percentage / 10);

			$(this).addClass(progress_level);

			$(this).animate({ width: percentage + "%"}, 800);
		});
	});
</script>
