  <tbody>
  <tr><td style="width:12%">انتخاب دیتابیس:</td><td><select class="selectclass" name="name"><option value="hosse285_wp" selected>hosse285_wp</option></select></td></tr>
  <tr><td style="width:12%" >انتخاب فایل بکاپ:</td><td><input type=file name="file1" size=40 class="combot"></td></tr>
  <tr><td colspan=2>
   <fieldset style="margin-top:15px;margin-top:15px;margin-bottom:15px;">
  <legend>روش اتصال به دیتابیس را انتخاب کنید</legend> 
  <table style="width:100%">
  <tr><td colspan=2><input type=radio name=method value=default checked onclick="setuserpass(true);"><label>اطلاعات لاگین دایرکت‌ادمین سرویس هاستینگ شما</label></td></tr>
  <tr><td><input type=radio name=method value=custom onclick="setuserpass(false);"> MySQL اطلاعات لاگین یک کاربر <span dir="ltr">[ نام کاربری: <input type=text size=16 class="combot" name=dbuser value="" disabled onclick="this.select()"> &nbsp; &nbsp; <span dir="rtl">رمز عبور</span>: <input type=password class="combot" size=16 name=dbpass value="" disabled> ]</span></td>
  </tr>
  </table>
  </fieldset>
  </td></tr>
  </tbody>
  <tfoot>
  <tr><td colspan=2><input type=submit value="آپلود"></td></tr>
  </tfoot>
  </table>
  </form>
  
