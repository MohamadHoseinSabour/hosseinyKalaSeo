<script>
function pma_login(event) {
        event.preventDefault();
        fetch('/api/phpmyadmin-sso/account-access', {method: 'POST'})
                .then((res) => res.json())
                .then((data) => window.open(data.url, '_blank').focus())
                .catch((err) => console.error(err));
}
</script>
<form onsubmit='pma_login(event)'>
        <input type="submit" value="phpMyAdmin SSO"> ورود به <span dir="ltr">phpMyAdmin</span> بدون نیاز به رمز عبور
</form>


 
  <form action="/CMD_DB" method="POST" name="tableform"><table cellpadding="3" cellspacing="1" class="list table-highlight"><tr><td class="listtitle">دیتابیس</td><td class="listtitle">تعداد کاربران</td><td class="listtitle">دانلود نسخه پشتیبان</td><td class="listtitle">حجم</td><td class="listtitle" align="center"><a class="listtitle" data-select-name="select" href="#" onclick="
const form = this.closest(&#34;form&#34;);
const inputs = Array.from(form?.querySelectorAll(&#34;input&#34;) || []);
const checkboxes = inputs.filter(v =&gt; v.type === &#34;checkbox&#34; &amp;&amp; v.name.startsWith(this.dataset.selectName));
const allChecked = checkboxes.reduce((acc, v) =&gt; acc &amp;&amp; v.checked, true);
checkboxes.forEach(v =&gt; v.checked = !allChecked);
return false;">انتخاب</a></td></tr><tr><td class="list"><a href="/CMD_DB_VIEW?name=hosse285_wp">hosse285_wp</a></td><td class="list">1</td><td class="list"><a href="/api/db-manage/databases/hosse285_wp/export?gzip=true">دانلود .gz</a> <a href="/api/db-manage/databases/hosse285_wp/export?gzip=false"> .sql</a></td><td class="list">31.8 MiB</td><td align="center" class="list"><input name="select0" type="checkbox" value="hosse285_wp" /></td></tr><tr><td align="right" class="listtitle" colspan="5"><input name="repair" style="margin-left:0.1em; margin-right:0.1em;" type="submit" value="اصلاح" /><input name="check" style="margin-left:0.1em; margin-right:0.1em;" type="submit" value="بررسی" /><input name="optimize" style="margin-left:0.1em; margin-right:0.11em;" type="submit" value="بهینه‌سازی" /><span style="margin-left:4em; margin-right:2em;">سایز کلی: 31.8 MiB</span><input name="delete_db" onclick="return confirm(&#34;آیا مطمئن هستید که می خواهید دیتابیس\u200Cهای انتخاب شده را حذف کنید؟&#34;)" type="submit" value="حذف" /></td></tr></table><input name="action" type="hidden" value="select" /></form>
  
  <div class="tip" style="width:534px;margin-top:10px;">جهت مدیریت کاربران و پسورد های هر دیتابیس، بر روی نام هر دیتابیس کلیک کنید</div>
  
  <form name=backupform action="/CMD_DB" enctype="multipart/form-data" method="post">
  <input type=hidden name=action value="restore">
  <table class="config" cellspacing=0 style="margin-top:20px;">
  <thead>
  <tr><td colspan=2>آپلود کردن بکاپ دیتابیس <span dir="ltr">(.gz)</span></td></tr>
